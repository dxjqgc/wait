# 前端环境变量模板
# 复制为 .env 并填入实际值

# Casdoor 应用配置
# 在 Casdoor 后台创建一个 Application，回调地址填：
#   http://localhost:5173/auth/callback
VITE_CASDOOR_SERVER_URL=http://127.0.0.1:18000
VITE_CASDOOR_CLIENT_ID=your_client_id
VITE_CASDOOR_CLIENT_SECRET=your_client_secret
VITE_CASDOOR_REDIRECT_URI=http://localhost:5173/auth/callback

# 后端 API 地址
# 开发环境走 Vite proxy 时，可设为空字符串；直连后端则填后端地址
VITE_API_BASE_URL=http://localhost:13001
